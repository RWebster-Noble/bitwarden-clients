// Dev Container Configuration for Bitwarden Clients Monorepo
// https://containers.dev/implementors/json_reference/
{
  "name": "Bitwarden Clients",

  // Build from the custom Dockerfile for additional dependencies
  // This includes Electron libraries, Rust toolchain, and build tools
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Features to add to the dev container
  // See: https://containers.dev/features
  "features": {
    // GitHub CLI for PR management and workflow integration
    "ghcr.io/devcontainers/features/github-cli:1": {},

    // Rust toolchain for desktop native module compilation
    // Required for apps/desktop/desktop_native (Cargo workspace)
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "default"
    },

    // Docker-in-Docker for any containerization needs
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "azureDnsAutoDetection": true,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true
    },

    // Common utilities
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },

  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      // Extensions to install when the container is created
      "extensions": [
        // Angular/Nx essentials
        "Angular.ng-template",
        "nrwl.angular-console",

        // TypeScript/JavaScript
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",

        // Testing
        "Orta.vscode-jest",
        "firsttris.vscode-jest-runner",

        // Rust (for desktop native modules)
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",

        // Git tools
        "eamodio.gitlens",
        "github.vscode-pull-request-github",

        // Utilities
        "editorconfig.editorconfig",
        "bradlc.vscode-tailwindcss",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",

        // Monorepo helpers
        "antfu.smart-clicks",
        "wix.vscode-import-cost",

        "nick-rudenko.back-n-forth",
        "MS-vsliveshare.vsliveshare",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "tamasfe.even-better-toml"
      ],

      // VS Code settings
      "settings": {
        // Editor
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // TypeScript
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,

        // ESLint
        "eslint.workingDirectories": [{ "mode": "auto" }],
        "eslint.useFlatConfig": true,

        // Jest
        "jest.jestCommandLine": "npm test --",
        "jest.autoRun": "off",

        // Rust
        "rust-analyzer.cargo.features": "all",
        "rust-analyzer.checkOnSave.command": "clippy",

        // Files
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/node_modules": true,
          "**/dist": true,
          "**/build": true
        },

        // Search
        "search.exclude": {
          "**/node_modules": true,
          "**/dist": true,
          "**/build": true,
          "**/.angular": true
        },

        // Nx
        "nx.showExplorer": true
      }
    }
  },

  // Run args for hosts file mapping (vault.qa.bitwarden.pw -> localhost)
  // and device access for FIDO2 virtual USB-HID device from fido2-hid-bridge
  "runArgs": [
    "--add-host=vault.qa.bitwarden.pw:127.0.0.1",
    // UHID device for virtual USB-HID (fido2-hid-bridge)
    "--device=/dev/uhid",
    // Allow dynamic hidraw device access (major 241)
    "--device-cgroup-rule=c 241:* rmw",
    // Allow UHID access (major 10, minor 239)
    "--device-cgroup-rule=c 10:239 rmw",
    // Add node user to input group for UHID access
    "--group-add=input"
  ],

  // Mounts for Wayland forwarding (for Firefox display)
  "mounts": [
    "source=/run/user/1000/wayland-0,target=/run/user/1000/wayland-0,type=bind,consistency=cached"
  ],

  // Forward ports for development servers
  "forwardPorts": [
    // Web Vault dev server
    4200,
    // Storybook
    6006,
    // Webpack dev server (various apps)
    8080,
    // API server (if running locally)
    5000,
    // HTTPS dev server
    3443
  ],
  "portsAttributes": {
    "4200": {
      "label": "Web Vault",
      "onAutoForward": "notify"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Webpack Dev Server",
      "onAutoForward": "silent"
    }
  },

  // Use 'postCreateCommand' to run commands after the container is created
  // This installs all npm dependencies, sets up Firefox certificates, and copies devcontainer config
  "postCreateCommand": "npm ci && setup-dev-certs.sh && .devcontainer/setup-local-config.sh",

  // Use 'postStartCommand' to run commands each time the container starts
  // Ensures git hooks are set up (husky)
  "postStartCommand": "npm run prepare",

  // Configure container resources
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  // Remote user configuration
  "remoteUser": "node",

  // Set environment variables
  "containerEnv": {
    "NODE_ENV": "development",
    "GIT_EDITOR": "code --wait",
    "NX_DAEMON": "true",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/run/user/1000"
  }
}
